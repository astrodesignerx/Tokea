# Database
# DATABASE_URL is used by the app at runtime (pooled connection is fine).
# DIRECT_URL is used by Prisma CLI for db push / migrate (must NOT be pooled).
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@host:5432/database

# Auth
# Generate with: npx auth secret
AUTH_SECRET=your-auth-secret
AUTH_URL=http://localhost:3012
NEXT_PUBLIC_APP_URL=http://localhost:3012

# Email (Resend)
# Without a valid key, magic-link sign-in still works in development:
# the link is printed to the dev server console instead of being emailed.
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=re_xxxxxxxxxxxx

# Payments (Paystack). Only needed for paid events.
# Dashboard → Settings → API Keys & Webhooks. The secret key also signs
# webhooks, so there is no separate webhook secret to configure.
# See the "Payments" section of README.md.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# Cron
CRON_SECRET=your-cron-secret

# Google OAuth (optional; the provider is only registered when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=false

# Storage (Cloudflare R2). Only needed for event cover uploads.
# See the "Storage" section of README.md; the bucket also needs a CORS policy
# allowing PUT from your app origin, or browser uploads fail.
STORAGE_ACCESS_KEY=placeholder
STORAGE_SECRET_KEY=placeholder
STORAGE_ENDPOINT=https://placeholder.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://placeholder.r2.dev
STORAGE_BUCKET=tokea-covers
STORAGE_REGION=auto
