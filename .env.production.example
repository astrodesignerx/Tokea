# Environment variables for a Vercel deployment.
#
# Names and guidance only — no values. Copy the values from .env.local EXCEPT
# where marked "MUST DIFFER", which are the ones that break silently if you
# paste the local value.

# --- Database -------------------------------------------------------------
# Pooled connection (port 6543, with pgbouncer=true). Serverless functions open
# a connection per invocation, so the pooler is not optional here.
DATABASE_URL=
# Direct connection (port 5432). Used by migrations only, which cannot run
# through a transaction pooler.
DIRECT_URL=

# --- Auth -----------------------------------------------------------------
# Note the name: AUTH_SECRET, not NEXTAUTH_SECRET.
AUTH_SECRET=
# MUST DIFFER from local. Set to the deployment's own origin, e.g.
# https://tokea.vercel.app. Left as localhost, every sign-in link points at the
# developer's machine and nobody can log in.
AUTH_URL=

# --- URLs -----------------------------------------------------------------
# MUST DIFFER from local. Used by the events side of the app.
NEXT_PUBLIC_APP_URL=
# The origin every QR code encodes. Read at runtime, so correcting it takes
# effect on the next request rather than the next build. Leave it unset on
# Vercel and card links follow the project's production URL automatically;
# set it once a custom domain exists.
CARDS_URL=

# --- Email ----------------------------------------------------------------
RESEND_API_KEY=
# MUST DIFFER from local if it is still onboarding@resend.dev: that sandbox
# address only delivers to the Resend account owner, so no guest or client
# would receive anything.
EMAIL_FROM=

# --- Cron -----------------------------------------------------------------
# vercel.json schedules /api/cron/reminders hourly. Without this the endpoint
# rejects Vercel's own calls.
CRON_SECRET=

# --- File storage ---------------------------------------------------------
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# --- Payments (events side; cards do not use these) -----------------------
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Google sign-in (optional) --------------------------------------------
NEXT_PUBLIC_GOOGLE_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
